# Multi-Stage Backend Dockerfile for Proton Pages Chemistry Gateway
FROM python:3.12-slim AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY services/chemistry/pyproject.toml services/chemistry/README.md ./services/chemistry/

RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
    "pydantic>=2.0.0" \
    "fastapi>=0.110.0" \
    "uvicorn[standard]>=0.28.0" \
    "sqlalchemy>=2.0.0" \
    "alembic>=1.13.0" \
    "psycopg2-binary>=2.9.0" \
    "python-multipart>=0.0.9" \
    "pytest>=8.0" \
    "pytest-cov>=5.0" \
    "httpx>=0.27.0"

FROM python:3.12-slim AS runner

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

COPY services/chemistry ./services/chemistry
COPY scripts ./scripts

ENV PYTHONPATH="/app:/app/services/chemistry"
ENV PYTHONUNBUFFERED=1

EXPOSE 8000

HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["uvicorn", "services.chemistry.app.server:app", "--host", "0.0.0.0", "--port", "8000"]

# ==============================================================================
# Proton Pages — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure local values.
# NEVER commit real passwords, secrets, or API keys to version control.

# Database Configuration (PostgreSQL)
POSTGRES_USER=proton
POSTGRES_PASSWORD=proton_dev_secret
POSTGRES_DB=proton_pages
POSTGRES_PORT=5432
DATABASE_URL=postgresql://proton:proton_dev_secret@localhost:5432/proton_pages

# Chemistry Engine & FastAPI Gateway
FASTAPI_PORT=8000
DEBUG=true
SQL_ECHO=false

# Frontend Configuration (Vite)
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_USE_MOCKS=false
PORT=5173
